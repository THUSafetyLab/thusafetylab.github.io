---
layout: default
---

<div class="post">

  <!-- ===========================
       Header
       =========================== -->

  <header class="post-header">

    <div style="
      display:flex;
      align-items:center;
      gap:12px;
      flex-wrap:wrap;
      margin-bottom:4px;
    ">

      <img
        src="{{ '/assets/img/logo_tsinghua_svm.png' | relative_url }}"
        alt="Tsinghua University"
        style="
          height:50px;
          width:auto;
          object-fit:contain;
          display:block;
        "
      >

      <h1 class="post-title" style="margin:0;">
        {% if site.title == 'blank' %}
          <span class="font-weight-bold">
            {{ site.first_name }}
          </span>
          {{ site.middle_name }}
          {{ site.last_name }}
        {% else %}
          {{ site.title }}
        {% endif %}
      </h1>

    </div>

    <p class="desc">
      {{ page.subtitle }}
    </p>

  </header>


  <article>

    <!-- ===========================
         Hero Section
         =========================== -->

    <div class="hero-section">

      <!-- Left text -->

      <div class="hero-text">

        <h1>
          Human-centered<br>
          Vehicle Safety
        </h1>

        <p>
          The Intelligent Safety Laboratory advances human-centered vehicle safety by integrating human cognition, artificial intelligence, experimental research, and engineering approaches toward the vision of zero traffic fatalities and serious injuries.
        </p>

        <a
          class="home-button primary"
          href="{{ '/Research/' | relative_url }}"
        >
          Explore Research
        </a>

        <a
          class="home-button secondary"
          href="{{ '/people/' | relative_url }}"
        >
          Meet the Team
        </a>

      </div>


      <!-- Right slideshow -->

      {% if page.profile.images %}

        <div class="hero-image">

          <div
            class="home-slideshow"
            aria-label="Intelligent Safety Laboratory photo slideshow"
          >

            {% for image in page.profile.images %}

              {% assign image_url = '/assets/img/' | append: image | relative_url %}

              <div
                class="home-slide{% if forloop.first %} active{% endif %}"
                aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
              >

                <!-- Background: blurred copy -->

                <img
                  class="home-slide-bg"
                  src="{{ image_url }}"
                  alt=""
                  aria-hidden="true"
                  loading="eager"
                  decoding="async"
                >

                <!-- Foreground: full original photo -->

                <img
                  class="home-slide-fg"
                  src="{{ image_url }}"
                  alt="Intelligent Safety Laboratory"
                  loading="eager"
                  decoding="async"
                >

              </div>

            {% endfor %}

          </div>

        </div>

      {% endif %}

    </div>


    <!-- ===========================
         Main page content
         Research Areas
         Latest News
         Recent Papers
         =========================== -->

    <div class="clearfix">
      {{ content }}
    </div>


    <!-- ===========================
         Social links
         =========================== -->

    {% if page.social %}

      <div class="social">

        <div class="contact-icons">
          {% social_links %}
        </div>

        <div class="contact-note">
          {{ site.contact_note }}
        </div>

      </div>

    {% endif %}

  </article>

</div>


<!-- ===========================
     Homepage styles
     =========================== -->

<style>

/* =========================================================
   HOME PAGE — Intelligent Safety Laboratory
   ========================================================= */


/* =========================================================
   Header
   ========================================================= */

.post-header {
  margin-bottom: 28px;
}

.post-header .post-title {
  font-size: 2rem;
  font-weight: 650;
  line-height: 1.2;
}

.post-header .desc {
  margin-top: 8px;
  font-size: 0.95rem;
  color: var(--global-text-color-light, #666);
}


/* =========================================================
   Hero — preserve original homepage layout
   ========================================================= */

.hero-section {
  display: grid;

  grid-template-columns:
    minmax(0, 1.05fr)
    minmax(360px, 0.95fr);

  gap: 56px;

  align-items: center;

  padding: 38px 0 72px;
  margin-bottom: 0;

  border-bottom: 1px solid
    var(--global-divider-color, #e5e5e5);
}


/* Left text */

.hero-text {
  width: auto;
  min-width: 0;
}

.hero-text h1 {
  margin: 0 0 24px;

  font-size: clamp(44px, 5vw, 64px);
  font-weight: 700;
  line-height: 1.08;
  letter-spacing: -0.03em;

  color: var(--global-text-color, #222);
}

.hero-text p {
  max-width: 620px;

  margin: 0 0 32px;

  font-size: 18px;
  line-height: 1.75;

  color: var(--global-text-color-light, #666);
}


/* Hero buttons */

.home-button {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  min-height: 44px;

  padding: 10px 22px;
  margin: 0 12px 10px 0;

  border-radius: 5px;

  font-size: 15px;
  font-weight: 500;

  text-decoration: none !important;

  transition:
    transform 0.2s ease,
    background-color 0.2s ease,
    color 0.2s ease,
    border-color 0.2s ease;
}

.home-button:hover {
  transform: translateY(-1px);
}

.home-button.primary {
  border: 1px solid #551a8b;
  background: #551a8b;
  color: #ffffff !important;
}

.home-button.primary:hover {
  background: #43146e;
  border-color: #43146e;
}

.home-button.secondary {
  border: 1px solid #551a8b;
  background: transparent;
  color: #551a8b !important;
}

.home-button.secondary:hover {
  background: #551a8b;
  color: #ffffff !important;
}


/* =========================================================
   Right image container
   ========================================================= */

.hero-image {
  width: 100%;
  min-width: 0;
}


/* =========================================================
   Slideshow
   Fixed 4:3 frame
   Blurred background + complete foreground
   ========================================================= */

.home-slideshow {
  position: relative;
  display: block;

  width: 100%;
  max-width: 100%;

  aspect-ratio: 4 / 3;

  overflow: hidden;
  border-radius: 12px;

  background: #f2f2f2;

  isolation: isolate;
}


/* Each slide fills the slideshow */

.home-slideshow .home-slide {
  position: absolute;
  inset: 0;

  display: block;

  width: 100%;
  height: 100%;

  box-sizing: border-box;

  margin: 0;
  padding: 0;

  opacity: 0;
  visibility: hidden;

  overflow: hidden;

  pointer-events: none;

  transition:
    opacity 0.8s ease-in-out,
    visibility 0s linear 0.8s;
}


/* Active slide */

.home-slideshow .home-slide.active {
  opacity: 1;
  visibility: visible;

  pointer-events: auto;

  transition:
    opacity 0.8s ease-in-out,
    visibility 0s linear 0s;
}


/* Scope image resets to slideshow images only */

.home-slideshow .home-slide img {
  position: absolute;
  inset: 0;

  display: block;

  width: 100%;
  height: 100%;

  max-width: none;
  max-height: none;

  min-width: 0;
  min-height: 0;

  margin: 0;
  padding: 0;

  border: 0;
  border-radius: 0;

  box-sizing: border-box;

  object-position: center;
}


/* Blurred background */

.home-slideshow .home-slide .home-slide-bg {
  object-fit: cover;

  filter: blur(18px);
  transform: scale(1.10);

  opacity: 0.80;

  z-index: 0;

  pointer-events: none;
}


/* Foreground photo — show the full image */

.home-slideshow .home-slide .home-slide-fg {
  object-fit: contain;

  filter: none;
  transform: none;

  opacity: 1;

  z-index: 1;
}


/* =========================================================
   Research Areas — preserve original styling
   ========================================================= */

.section-title {
  margin: 72px 0 30px;

  font-size: 30px;
  font-weight: 700;
  line-height: 1.2;

  letter-spacing: -0.015em;

  color: var(--global-text-color, #222);
}

.research-grid {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 28px;

  margin-bottom: 76px;
}

.research-card {
  min-width: 0;
  height: 100%;

  overflow: hidden;

  border: 1px solid
    var(--global-divider-color, #e5e5e5);

  border-radius: 12px;

  padding: 0;

  background: var(--global-bg-color, #fff);

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

.research-card:hover {
  transform: translateY(-4px);

  box-shadow:
    0 8px 18px rgba(0, 0, 0, 0.06),
    0 18px 40px rgba(0, 0, 0, 0.06);
}


/* Research cover images */

.research-card img {
  display: block;

  width: 100%;
  height: 220px;

  margin: 0;

  border-radius: 0;

  object-fit: cover;
  object-position: center;
}

.research-card h3 {
  margin: 0;

  padding: 22px 24px 12px;

  font-size: 20px;
  font-weight: 650;
  line-height: 1.35;

  color: var(--global-text-color, #222);
}

.research-card ul {
  margin: 0;

  padding: 0 24px 24px 44px;
}

.research-card li {
  margin-bottom: 6px;

  font-size: 15px;
  line-height: 1.6;

  color: var(--global-text-color-light, #666);
}


/* =========================================================
   Latest News + Recent Papers
   ========================================================= */

.bottom-grid {
  display: grid;

  grid-template-columns:
    minmax(0, 0.9fr)
    minmax(0, 1.1fr);

  gap: 60px;

  align-items: start;

  margin-top: 10px;
  padding-top: 38px;

  border-top: 1px solid
    var(--global-divider-color, #e5e5e5);
}

.bottom-grid > div {
  min-width: 0;
}

.bottom-grid h2 {
  margin: 0 0 24px;

  font-size: 27px;
  font-weight: 700;
  line-height: 1.25;

  color: var(--global-text-color, #222);
}

.bottom-grid h2 a {
  color: inherit !important;
  text-decoration: none !important;
}


/* Keep content inside its column */

.home-papers-column,
.home-news-column {
  width: 100%;
  min-width: 0;
}


/* =========================================================
   Responsive — preserve original breakpoints
   ========================================================= */

@media (max-width: 1000px) {

  .hero-section {
    grid-template-columns: 1fr 1fr;
    gap: 36px;
  }

  .hero-text h1 {
    font-size: 44px;
  }

  .research-grid {
    gap: 20px;
  }

  .research-card img {
    height: 190px;
  }

}


@media (max-width: 800px) {

  .hero-section {
    grid-template-columns: 1fr;

    gap: 36px;

    padding: 24px 0 54px;
  }

  .hero-image {
    max-width: 640px;
  }

  .hero-text h1 {
    font-size: 42px;
  }

  .research-grid {
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .research-card img {
    height: 260px;
  }

  .bottom-grid {
    grid-template-columns: 1fr;
    gap: 54px;
  }

}


@media (max-width: 520px) {

  .hero-text h1 {
    font-size: 36px;
  }

  .hero-text p {
    font-size: 16px;
  }

  .home-button {
    width: 100%;
    margin-right: 0;
  }

  .section-title {
    margin-top: 54px;
    font-size: 26px;
  }

  .research-card img {
    height: 210px;
  }

}


/* Reduced motion */

@media (prefers-reduced-motion: reduce) {

  .home-slideshow .home-slide,
  .home-slideshow .home-slide.active {
    transition: none;
  }

}

</style>


<!-- ===========================
     Slideshow JavaScript
     =========================== -->

<script>
(function () {
  "use strict";

  function initializeSlideshow() {

    const slideshow =
      document.querySelector(".home-slideshow");

    if (!slideshow) return;

    if (slideshow.dataset.initialized === "true") {
      return;
    }

    slideshow.dataset.initialized = "true";

    const slides = Array.from(
      slideshow.querySelectorAll(".home-slide")
    );

    if (slides.length === 0) return;

    let current = 0;

    const interval = 4000;


    /* Check image loading */

    function isLoaded(slide) {

      const image =
        slide.querySelector(".home-slide-fg");

      return Boolean(
        image &&
        image.complete &&
        image.naturalWidth > 0
      );

    }


    /* Activate one slide */

    function showSlide(index) {

      slides.forEach(function (slide, i) {

        const active = i === index;

        slide.classList.toggle(
          "active",
          active
        );

        slide.setAttribute(
          "aria-hidden",
          active ? "false" : "true"
        );

      });

      current = index;

    }


    /* Find the next loaded image */

    function nextSlide() {

      for (let step = 1; step <= slides.length; step++) {

        const index =
          (current + step) % slides.length;

        if (isLoaded(slides[index])) {

          if (index !== current) {
            showSlide(index);
          }

          return;

        }

      }

    }


    /* Ensure all slideshow images are loaded */

    slides.forEach(function (slide) {

      const images =
        slide.querySelectorAll("img");

      images.forEach(function (image) {
        image.loading = "eager";
      });

    });


    /* Show first successfully loaded image */

    const initialIndex =
      slides.findIndex(isLoaded);

    if (initialIndex >= 0) {

      showSlide(initialIndex);

    } else {

      /* Keep first slide as placeholder */

      showSlide(0);

      slides.forEach(function (slide, index) {

        const image =
          slide.querySelector(".home-slide-fg");

        if (!image) return;

        image.addEventListener(
          "load",
          function () {

            const activeSlide =
              slides[current];

            if (!isLoaded(activeSlide)) {
              showSlide(index);
            }

          }
        );

      });

    }


    /* Skip failed image when necessary */

    slides.forEach(function (slide, index) {

      const image =
        slide.querySelector(".home-slide-fg");

      if (!image) return;

      image.addEventListener(
        "error",
        function () {

          if (current === index) {
            nextSlide();
          }

        }
      );

    });


    /* Automatic rotation */

    if (slides.length > 1) {

      window.setInterval(
        nextSlide,
        interval
      );

    }

  }


  /* Initialize safely */

  if (document.readyState === "loading") {

    document.addEventListener(
      "DOMContentLoaded",
      initializeSlideshow,
      { once: true }
    );

  } else {

    initializeSlideshow();

  }

})();
</script>
